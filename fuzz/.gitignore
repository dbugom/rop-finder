# cargo-fuzz and the smoke harness each build into their own target dir
# (they are separate workspaces from the root; see fuzz/Cargo.toml).
target/
smoke/target/

# `rf-smoke seed-corpus --full` copies whole fixtures in for a long local
# run. Those are ~18 MB of third-party binaries that already live in
# tests/fixtures/ — regenerate them, do not commit them.
corpus/**/*.full

# libFuzzer names every input it discovers after its SHA-1. Those files are
# regenerated by any run and grew to 11.5 MB in 60 s per target here, so they
# are NOT committed — ENG-13 is about exactly this kind of repository bloat.
# What IS committed is the deterministic seed corpus (`rf-smoke seed-corpus`,
# fixture-named files) and every crasher under artifacts/, which is what a
# regression gate actually needs. CI caches the grown corpus between runs and
# uploads it as a job artifact; see the workflow snippet in README.md.
corpus/*/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*

# ROB-02 amplification witnesses are generated on demand by
# `rf-smoke amplify` and are megabytes of cloned section headers.
artifacts/smoke/amplify-*.bin

# libFuzzer's own coverage/profile droppings.
*.profraw
default.profraw
