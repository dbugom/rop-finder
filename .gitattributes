# Line endings are part of this repository's correctness, not a style question.
#
# CLS-11 pins the hand-labeled classifier corpus with a SHA-256 manifest, and
# the test asserts the hash is unchanged during a run — that is the guard which
# stops the corpus being regenerated to match whatever the classifier currently
# says. A hash over bytes cannot survive checkout translation: with no
# .gitattributes, git applied core.autocrlf and a fresh clone received
# tests/classify-corpus/arm.jsonl with 25 CRLF pairs, 22,644 bytes instead of
# 22,619, so `cargo test --workspace` failed on ubuntu-22.04, macos-14 and
# windows-2022 while passing on the machine that wrote the manifest.
#
# Normalise everything to LF in the working tree on every platform, so a hash
# taken anywhere is valid everywhere.
* text=auto eol=lf

# Hash-pinned data: never translate these, whatever the global setting.
tests/classify-corpus/*.jsonl   -text
tests/classify-corpus/*.sha256  -text
tests/parity-baseline/*.json    -text
tests/fixtures/MANIFEST.sha256  -text
crates/rf-classify/tests/ground-truth/*.jsonl -text

# The 24 third-party test binaries. Git detects these as binary on its own, but
# say so explicitly: a translated fixture would silently change every gadget
# address in the parity gate.
tests/fixtures/**    binary
*.raw                binary
*.so                 binary
*.dylib              binary
*.exe                binary

# Scripts that a shell or PowerShell executes directly.
*.sh    text eol=lf
*.ps1   text eol=crlf
